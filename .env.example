# Self-hosted Mailspring-API (identity + metadata sync + open/link tracking).
# Read at `npm start` / `npm run build` time and baked into app/selfhost-config.json.
MAILSPRING_SERVER_URL=https://mailspring.example.com
# Optional: secret path segment for auto-updates (openssl rand -hex 32). Leave unset to
# build without auto-update.
# MAILSPRING_UPDATE_TOKEN=
